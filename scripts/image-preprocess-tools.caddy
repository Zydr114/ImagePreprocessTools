# ImagePreprocessTools: independent static application route.
redir /ImagePreprocessTools /ImagePreprocessTools/ 308

# Keep previously shared links working, including resource paths and queries.
redir /ImageProprocessTools /ImagePreprocessTools/ 308

handle_path /ImageProprocessTools/* {
	redir * /ImagePreprocessTools{uri} 308
}

handle_path /ImagePreprocessTools/* {
	root * /var/www/tool.talium.site/ImagePreprocessTools/current
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	route {
		@imageHashed path /assets/*
		header @imageHashed Cache-Control "public, max-age=31536000, immutable"
		@imageEntry not path /assets/*
		header @imageEntry Cache-Control "no-cache"
		file_server
	}
}
